# ── IBKR ─────────────────────────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = TWS Paper, 7496 = TWS Live, 4002 = Gateway Paper, 4001 = Gateway Live
IBKR_CLIENT_ID=1
REAL_MODE=false          # NIGDY nie zmieniaj ręcznie – używaj panelu + podwójnego potwierdzenia

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# ── Panel / Security ──────────────────────────────────────────────────────────
PANEL_USERNAME=admin
PANEL_PASSWORD_HASH=$2b$12$ZMIEŃ_NA_HASH_BCRYPT
SECRET_KEY=zmien-na-losowy-klucz-256bit
EMERGENCY_STOP_PASSWORD=super_tajne_haslo_stop

# ── Alerting ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Risk Defaults ─────────────────────────────────────────────────────────────
MAX_DAILY_LOSS_USD=500.0
MAX_DRAWDOWN_PCT=10.0
TOTAL_CAPITAL_USD=10000.0
MAX_POSITION_SIZE_PCT=5.0

# ── AI Chat ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=             # opcjonalne – jeśli puste, używa Ollama lub wbudowanego parsera
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
